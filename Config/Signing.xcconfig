// Code signing for NotchHub.
//
// Default: ad-hoc "Sign to Run Locally". This works, but every rebuild changes the code
// signature, so macOS forgets the Accessibility grant after each build.
//
// For a grant that survives rebuilds, copy Signing.local.xcconfig.example to
// Signing.local.xcconfig (untracked) and pick a stable identity there. See README.

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
